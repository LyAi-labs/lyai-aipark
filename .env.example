# ==============================================================================
# CARTOON STUDIO — SERVER-FIRST ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV="development"
PORT=4000
APP_URL="http://localhost:4000"

# --- Database (PostgreSQL) ---------------------------------------------------
# Connection string for PostgreSQL (local Docker Compose or remote server)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cartoon_studio?schema=public"

# --- AI Services (Google GenAI) ----------------------------------------------
# Google Gemini API key for story, character bible and metadata generation
GEMINI_API_KEY=""

# --- Voice & Speech Synthesis (Phase 06) ---------------------------------------
# Options: 'google-cloud-tts' | 'synthetic' (default falls back to synthetic if key absent)
TTS_PROVIDER="google-cloud-tts"
# Separate TTS key or reuses GEMINI_API_KEY if both APIs enabled on the GCP project
TTS_API_KEY=""
TTS_DEFAULT_LANGUAGE="es-ES"
TTS_DEFAULT_VOICE="es-ES-Neural2-A"

# --- Storage Engine (StorageProvider) ----------------------------------------
# Options: 'local' | 's3'
STORAGE_DRIVER="local"
STORAGE_PATH="./storage/assets"

# S3-Compatible configuration (used when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_BUCKET="cartoon-studio-assets"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# --- YouTube & Google OAuth 2.0 ----------------------------------------------
# Google Cloud Console credentials with YouTube Data API v3 scope
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# --- Authentication (Phase 03) -----------------------------------------------
# JWT signing secret for access & refresh tokens (HS256). Min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Cookie-parser signing secret (defence-in-depth). Min 32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=""
